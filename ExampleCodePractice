}import java.util.List;

public interface ILibrarySystem {

    void addBook(IBook book, int quantity);

    void removeBook(IBook book, int quantity);

    int calculateTotalPrice();

    List<BookInfo> booksInfo();   // ✅ updated
}
import java.util.*;

public class LibrarySystem implements ILibrarySystem {

    private Map<IBook, Integer> books = new HashMap<>();

    public void addBook(IBook book, int quantity) {
        books.put(book, books.getOrDefault(book, 0) + quantity);
    }

    public void removeBook(IBook book, int quantity) {
        if (!books.containsKey(book)) return;

        int current = books.get(book);

        if (quantity >= current) {
            books.remove(book);
        } else {
            books.put(book, current - quantity);
        }
    }

    public int calculateTotalPrice() {
        int total = 0;

        for (Map.Entry<IBook, Integer> entry : books.entrySet()) {
            total += entry.getKey().getPrice() * entry.getValue();
        }

        return total;
    }

    // ✅ MAIN CHANGE HERE
    public List<BookInfo> booksInfo() {

        // Step 1: Grouping (category + author → count)
        Map<String, Integer> temp = new HashMap<>();

        for (Map.Entry<IBook, Integer> entry : books.entrySet()) {
            IBook book = entry.getKey();
            int count = entry.getValue();

            String key = book.getCategory() + "-" + book.getAuthor();

            temp.put(key, temp.getOrDefault(key, 0) + count);
        }

        // Step 2: Convert Map → List
        List<BookInfo> result = new ArrayList<>();

        for (Map.Entry<String, Integer> entry : temp.entrySet()) {
            String[] parts = entry.getKey().split("-");
            String category = parts[0];
            String author = parts[1];

            result.add(new BookInfo(category, author, entry.getValue()));
        }

        return result;
    }
}
